{
  "type": "module",
  "name": "@chord-ts/rpc",
  "version": "1.0.0-beta.32",
  "author": "Din Dmitriy @dmdin",
  "description": "💎 Cutting edge transport framework vanishing borders between frontend and backend",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chord-ts/rpc.git"
  },
  "keywords": [
    "JSON-RPC",
    "Client Server",
    "Transport"
  ],
  "license": "Apache License 2.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/v1/index.d.ts",
      "import": "./dist/v1/index.js"
    },
    "./client": {
      "types": "./dist/v1/client/index.d.ts",
      "import": "./dist/v1/client/index.js"
    },
    "./middlewares": {
      "types": "./dist/v1/middlewares/index.d.ts",
      "import": "./dist/v1/middlewares/index.js"
    },
    "./middlewares/*": {
      "types": "./dist/v1/middlewares/*.d.ts",
      "import": "./dist/v1/middlewares/*.js"
    },
    "./validators": {
      "types": "./dist/v1/validators/index.d.ts",
      "import": "./dist/v1/validators/index.js"
    },
    "./specs": {
      "types": "./dist/v1/specs/index.d.ts",
      "import": "./dist/v1/specs/index.js"
    }
  },
  "types": "./dist/v1/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "nodemon --exec npx ts-node src/tests.ts",
    "format": "prettier --write ./src/**/*.{js,json,html,ts}",
    "lint": "eslint --fix ./src",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsdown && tsc --emitDeclarationOnly --outDir dist/v1",
    "build:dts": "tsc --emitDeclarationOnly --outDir dist/v1",
    "minify": "terser --compress --module -o ./dist/v1/client/index.js -- ./dist/v1/client/index.js && terser --compress --module -o ./dist/v1/specs/index.js -- ./dist/v1/specs/index.js",
    "patch": "pnpm run build && pnpm version patch --no-git-tag-version"
  },
  "devDependencies": {
    "@open-rpc/meta-schema": "^1.14.6",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@vitest/coverage-v8": "^1.6.0",
    "arktype": "^2.2.9",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.0",
    "terser": "^5.26.0",
    "tsdown": "^0.23.7",
    "tslib": "^2.6.2",
    "typescript": "5.5.3",
    "unplugin-swc": "^1.4.5",
    "valibot": "^1.5.0",
    "vitest": "^1.6.0",
    "yup": "^1.7.1",
    "zod4": "npm:zod@4"
  }
}